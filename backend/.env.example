# ==============================================================================
# EduCart Backend Environment Configuration Template
# Copy this file to .env and provide your actual secrets locally or in your deployment provider.
# NEVER commit the real .env file into Git version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
# Generate a cryptographically secure random secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_hex_string_here

# Database Configuration (MongoDB Atlas or local MongoDB)
# Atlas format: mongodb+srv://<username>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority
# Local format:  mongodb://localhost:27017/educart
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/educart?retryWrites=true&w=majority

# External Email Service (Gmail SMTP via Google App Password)
# NOTE: Do NOT use your regular Google account password. Use an App Password generated in Google Security settings.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Frontend URL (CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Cloudinary Media Storage (Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateways (Optional)
PAYPAL_CLIENT_ID=sb
